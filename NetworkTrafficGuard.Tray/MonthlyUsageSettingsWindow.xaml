<Window x:Class="NetworkTrafficGuard.Tray.MonthlyUsageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Texts.MonthlyUsageSettingsTitle}" Height="240" Width="460"
        MinHeight="240" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding Texts.MonthlyUsageSettingsTitle}" FontSize="22" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <CheckBox IsChecked="{Binding ShowMonthlyTrafficUsage, Mode=TwoWay}"
                      Content="{Binding Texts.ShowMonthlyTrafficUsage}" />

            <Button Content="{Binding Texts.ClearMonthlyTrafficUsage}"
                    MinWidth="140"
                    Height="32"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0"
                    Click="ClearButton_Click" />

            <TextBlock Text="{Binding StatusText}"
                       Foreground="#64748B"
                       Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Texts.Save}" MinWidth="90" Height="32" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="{Binding Texts.Cancel}" MinWidth="90" Height="32" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
