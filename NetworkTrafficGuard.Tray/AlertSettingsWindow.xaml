<Window x:Class="NetworkTrafficGuard.Tray.AlertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Texts.AlertSettingsTitle}" Height="220" Width="420"
        MinHeight="220" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding Texts.AlertSettingsTitle}" FontSize="22" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Texts.AlertThresholdLabel}"
                       Foreground="#64748B"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding AlertThresholdKbps, UpdateSourceTrigger=PropertyChanged}"
                         Width="100"
                         MinWidth="100"
                         Height="28"
                         Margin="0" />
                <TextBlock Text="{Binding Texts.AlertThresholdUnit}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Texts.Save}" MinWidth="90" Height="32" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="{Binding Texts.Cancel}" MinWidth="90" Height="32" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
