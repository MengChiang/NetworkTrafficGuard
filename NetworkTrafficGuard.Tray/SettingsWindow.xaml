<Window x:Class="NetworkTrafficGuard.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Texts.SettingsTitle}" Height="500" Width="760"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Texts.SettingsTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Texts.SettingsDescription}"
                       Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding CurrentNetwork}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.Texts.ExistingNetworkColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="260">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.Texts.DisplayNameColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="220" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <CheckBox IsChecked="{Binding EnableAdapterChanges, Mode=TwoWay}"
                          Content="{Binding Texts.AllowAdapterChanges}" />
                <CheckBox IsChecked="{Binding EnableRouteChanges, Mode=TwoWay}"
                          Margin="0,8,0,0"
                          Content="{Binding Texts.AllowRouteChanges}" />
                <TextBlock Text="{Binding Texts.AlertSettingsTitle}"
                           FontWeight="SemiBold"
                           Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Texts.AlertThresholdLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBox Text="{Binding AlertThresholdKbps, UpdateSourceTrigger=PropertyChanged}"
                             Width="88"
                             MinWidth="88"
                             Margin="0" />
                    <TextBlock Text="{Binding Texts.AlertThresholdUnit}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Texts.Save}" MinWidth="90" Height="32" Margin="0,0,8,0" Click="SaveButton_Click" />
                <Button Content="{Binding Texts.Cancel}" MinWidth="90" Height="32" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
