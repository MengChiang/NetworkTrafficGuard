<Window x:Class="NetworkTrafficGuard.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="網路名稱設定" Height="460" Width="760"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="網路名稱設定" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="左邊是目前偵測到的網路，右邊是你要顯示在主畫面的名稱。"
                       Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="現有網路" Binding="{Binding CurrentNetwork}" IsReadOnly="True" Width="*" />
                <DataGridTemplateColumn Header="自訂名稱" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="220" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" MinWidth="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="儲存" MinWidth="90" Height="32" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
