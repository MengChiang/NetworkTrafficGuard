<Window x:Class="NetworkTrafficGuard.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Traffic Guard" Height="680" Width="1040"
        MinHeight="600" MinWidth="920"
        Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="BorderBrush" Value="#D7DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardIcon" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Command="{Binding OpenSettingsCommand}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Settings" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="設定" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="Wi-Fi">
                <MenuItem Command="{Binding EnableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wifi" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi 開啟" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Command="{Binding DisableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="WifiOff" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi 關閉" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding AdapterControlStatusText}" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Activity" Width="30" Height="30" Foreground="#2563EB" Margin="0,2,10,0" />
                        <TextBlock Text="通信" FontSize="30" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLineText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="自動更新" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LastCheckedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wifi" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding WifiDisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding WifiStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WifiDetailText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ToggleButton IsChecked="{Binding IsWifiToggleChecked, Mode=TwoWay}"
                                              Command="{Binding SetWifiEnabledCommand}"
                                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Wifi" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Wi-Fi" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="{Binding AdapterControlStatusText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Router" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RouterLineLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding RouterDisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MobileDataStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MobileDataDetailText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="使用優先順序" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding MoveRouteUpCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowUp" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="上移" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MoveRouteDownCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowDown" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="下移" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Routes}"
                                  SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="波型" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsMonitored, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Command="{Binding DataContext.MonitorRouteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="優先" Binding="{Binding Role}" Width="76" />
                                <DataGridTextColumn Header="網路" Binding="{Binding NetworkName}" Width="190" />
                                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="260" />
                                <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AddressFamily}" Width="72" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconLucide Kind="Activity" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="即時流量" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrafficMonitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D7DDE5"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,12"
                                            Background="#FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,8" />
                                            <TextBlock Text="{Binding RateText}" Margin="0,0,0,8" />
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Background="#FAFAFA">
                                                <TextBlock Text="{Binding Sparkline}"
                                                           FontSize="34"
                                                           FontFamily="Consolas"
                                                           Foreground="#111111"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
