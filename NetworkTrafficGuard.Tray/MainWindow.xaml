<Window x:Class="NetworkTrafficGuard.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Traffic Guard" Height="680" Width="1040"
        MinHeight="600" MinWidth="920"
        Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="BorderBrush" Value="#D7DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardIcon" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="設定">
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="280" Margin="4">
                            <TextBlock Text="Wi-Fi 顯示名稱" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditableWifiDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SIM 路由器名稱" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditableSimDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="電信商 / 回線名稱" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditableSimCarrierName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Gateway 對應請選取左側網路後在右側編輯。" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                            <Button Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Save" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="儲存設定" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Wi-Fi">
                <MenuItem Command="{Binding EnableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wifi" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi 開啟" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Command="{Binding DisableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="WifiOff" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi 關閉" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Header="目前為 dry-run；EnableAdapterChanges=true 才會真的改網卡。" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Activity" Width="30" Height="30" Foreground="#2563EB" Margin="0,2,10,0" />
                        <TextBlock Text="通信" FontSize="30" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveLineText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="自動更新" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LastCheckedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wifi" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Wi-Fi" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding WifiDisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding WifiStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WifiDetailText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ToggleButton IsChecked="{Binding IsWifiToggleChecked, Mode=TwoWay}"
                                              Command="{Binding SetWifiEnabledCommand}"
                                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Wifi" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Wi-Fi" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Router" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RouterLineLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding RouterDisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MobileDataStatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MobileDataDetailText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="使用優先順序" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding MoveRouteUpCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowUp" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="上移" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MoveRouteDownCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowDown" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="下移" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Routes}"
                                  SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="優先" Binding="{Binding Role}" Width="76" />
                                <DataGridTextColumn Header="網路" Binding="{Binding NetworkName}" Width="190" />
                                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="260" />
                                <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AddressFamily}" Width="72" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="Activity" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="選取網路" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedNetworkTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNetworkDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />

                        <TextBlock Text="顯示名稱" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding EditableSelectedNetworkName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{Binding SaveSelectedNetworkNameCommand}" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Save" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="儲存對應" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="即時流量" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TrafficRateText}" />
                        <TextBlock Text="{Binding TrafficSparkline}" FontSize="28" FontFamily="Consolas" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding RouteControlText}" Style="{StaticResource MutedText}" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
