<Window x:Class="NetworkTrafficGuard.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Traffic Guard" Height="680" Width="1040"
        MinHeight="600" MinWidth="920"
        Icon="Assets/network-traffic-guard.ico"
        Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="BorderBrush" Value="#D7DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CompactPanelBorder" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="CardIcon" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#C8D1DC" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem>
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Settings" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Texts.Settings}" />
                    </StackPanel>
                </MenuItem.Header>
                <MenuItem Command="{Binding OpenSettingsCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Settings" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Texts.Settings}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding EnableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wifi" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding EnableWifiMenuText}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Command="{Binding DisableWifiCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="WifiOff" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisableWifiMenuText}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Activity" Width="30" Height="30" Foreground="#2563EB" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding Texts.AppTitle}" FontSize="30" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CompactPanelBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Wifi" Width="20" Height="20" Foreground="#2563EB" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Texts.WifiLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WifiDisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WifiStatusText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding WifiDetailText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CompactPanelBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Router" Width="20" Height="20" Foreground="#2563EB" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding RouterLineLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RouterDisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding MobileDataStatusText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding MobileDataDetailText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Texts.PriorityTitle}" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding MoveRouteUpCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowUp" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Texts.MoveUp}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MoveRouteDownCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ArrowDown" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Texts.MoveDown}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Routes}"
                                  SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="58">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding DataContext.Texts.ShowColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsMonitored, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Command="{Binding DataContext.MonitorRouteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Priority}" Width="56">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.Texts.PriorityColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding NetworkName}" Width="190">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.Texts.NetworkColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Gateway}" Width="*">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.Texts.GatewayColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding AddressFamily}" Width="72">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.Texts.TypeColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding RouteControlText}"
                                   Visibility="{Binding RouteControlVisibility}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <iconPacks:PackIconLucide Kind="Activity" Style="{StaticResource CardIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Texts.RealtimeTraffic}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrafficMonitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D7DDE5"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,12"
                                            Background="#FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,8" />
                                            <TextBlock Text="{Binding RateText}" Margin="0,0,0,8" />
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Background="#FAFAFA">
                                                <TextBlock Text="{Binding Sparkline}"
                                                           FontSize="34"
                                                           FontFamily="Consolas"
                                                           Foreground="#111111"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
